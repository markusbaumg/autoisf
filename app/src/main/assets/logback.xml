<configuration>
    <!-- Create a file appender for a log in the application's data directory -->
    <property name="EXT_FILES_DIR" scope="context" value="/storage/emulated/0/Documents/aapsLogs" />
    <!-- AndroidAPS.log, or AndroidAPS_1.log .. _9 when this process can not write the old one (it
     belongs to an earlier install or to the app before its data was cleared), so file logging never
     stops silently. See WritableLogFileDefiner. -->
    <define name="ACTIVE_LOG_FILE" class="app.aaps.implementation.logging.WritableLogFileDefiner">
        <directory>${EXT_FILES_DIR}</directory>
        <fileName>AndroidAPS.log</fileName>
    </define>
    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ACTIVE_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- hourly rollover. Make sure the path matches the one in the file element or else
             the rollover logs are placed in the working directory. -->
            <fileNamePattern>${EXT_FILES_DIR}/AndroidAPS._%d{yyyy-MM-dd_HH}.log.zip</fileNamePattern>
            <!-- keep 30 days (hourly archives) worth of history -->
            <maxHistory>720</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %.-1level/%logger: %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="logcat" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder>
            <pattern>%logger{0}</pattern>
        </tagEncoder>
        <encoder>
            <pattern>[%thread]: %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Write INFO (and higher-level) messages to the log file -->
    <root level="DEBUG">
        <appender-ref ref="file" />
        <appender-ref ref="logcat" />
    </root>
</configuration>
