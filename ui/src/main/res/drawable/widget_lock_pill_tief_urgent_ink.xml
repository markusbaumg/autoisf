<?xml version="1.0" encoding="utf-8"?>
<!-- KUSI: lock-widget (AAPS Sperrbildschirm), generated with the lock widget; display only -->
<!-- Urgent low: the solid pill plus an outer ring 3 dp outside it (doubled frame). The ring is the view's edge,
     so LockWidgetRenderer adds 3 dp to the padding. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#D21F3C" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#D21F3C" />
        </shape>
    </item>
</layer-list>
