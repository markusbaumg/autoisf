<?xml version="1.0" encoding="utf-8"?>
<!-- Range bloom behind the BG digits (recipe L2), softer core since the 24 Oct contrast fix (sits on the BG scrim): dense core, soft wide falloff.
     Static drawable (no blur at runtime). There is no bloom for low: red digits on a red glow fail contrast. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:centerColor="#1E1FE38C"
        android:endColor="#001FE38C"
        android:gradientRadius="50%p"
        android:startColor="#401FE38C"
        android:type="radial" />
</shape>
