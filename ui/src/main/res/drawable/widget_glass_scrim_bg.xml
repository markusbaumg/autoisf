<?xml version="1.0" encoding="utf-8"?>
<!-- Local dark scrim behind the BG digits, arrow and age: keeps the BG >= 4.5:1 (red low too) on light or
     yellow wallpapers. Static drawable, no blur. Same bounds as the bloom view; centred on the digits. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.25"
        android:centerY="0.5"
        android:gradientRadius="56%p"
        android:startColor="#99000000"
        android:centerColor="#80000000"
        android:endColor="#00000000" />
</shape>
