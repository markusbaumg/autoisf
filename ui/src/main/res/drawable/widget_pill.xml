<?xml version="1.0" encoding="utf-8"?>
<!-- Glass bolus pill: faint white film, 1 dp rim brighter at the top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:endColor="#1AFFFFFF"
                android:startColor="#2EFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#21FFFFFF" />
        </shape>
    </item>
    <!-- brighter top: the rim again, clipped to the upper half (Widget.kt sets the level) -->
    <item>
        <clip
            android:clipOrientation="vertical"
            android:gravity="top">
            <shape android:shape="rectangle">
                <corners android:radius="15dp" />
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="1dp"
                    android:color="#61FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
