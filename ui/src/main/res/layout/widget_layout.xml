<?xml version="1.0" encoding="utf-8"?>
<!-- AAPS home-screen widget, design R2 "Luft": glass card, BG + age, TIR meters 24 h / 7 d / 30 d, IOB / COB / TDD, two quick-bolus pills -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/glass_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_tint" />

    <ImageView
        android:id="@+id/bloom"
        android:layout_width="170dp"
        android:layout_height="130dp"
        android:layout_gravity="start|center_vertical"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_bloom_in" />

    <ImageView
        android:id="@+id/glass_film"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_film" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="190dp"
                android:textSize="12.5sp"
                tools:text="Lyumjev FCL" />

            <TextView
                android:id="@+id/target"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12.5sp"
                tools:text="Ziel 5,0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bg"
                    style="@style/WidgetGlassText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-1.5dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_glass_in"
                    android:textSize="44sp"
                    tools:text="6,5" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/arrow"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/age"
                        style="@style/WidgetGlassText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        tools:text="vor 1′" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="142dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir1_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_24h"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir1_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir1"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir2_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_7d"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir2_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir2"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir3_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_30d"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir3_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir3"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_iob"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/iob"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_cob"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cob"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tdd"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tdd"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14.5sp" />
        </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        <!-- Carbs pill: opens the AAPS bolus wizard (WidgetWizardActivity -> MainActivity), no amount of its own -->
        <FrameLayout
            android:id="@+id/carbs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:minWidth="42dp">

            <ImageView
                android:id="@+id/carbs_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <TextView
                android:id="@+id/carbs_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/widget_carbs_pill"
                android:textColor="@color/widget_glass_txt2"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bolus1"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="0dp">

            <ImageView
                android:id="@+id/bolus1_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <TextView
                android:id="@+id/bolus1_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bolus2"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/bolus2_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <TextView
                android:id="@+id/bolus2_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14sp" />
        </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
