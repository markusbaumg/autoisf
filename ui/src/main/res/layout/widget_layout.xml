<?xml version="1.0" encoding="utf-8"?>
<!-- AAPS home-screen widget, design R2 "Luft": glass card, BG + age, TIR meters 24 h / 7 d / 30 d, IOB / COB / TDD, two quick-bolus pills -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/glass_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_tint" />

    <ImageView
        android:id="@+id/glass_film"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_film" />

    <!-- static dark scrim behind the BG digits, under the bloom: the frost no longer lightens it -->
    <ImageView
        android:id="@+id/bg_scrim"
        android:layout_width="230dp"
        android:layout_height="176dp"
        android:layout_gravity="start|center_vertical"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_scrim_bg" />

    <ImageView
        android:id="@+id/bloom"
        android:layout_width="230dp"
        android:layout_height="176dp"
        android:layout_gravity="start|center_vertical"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_bloom_in" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <!-- Spacing: the free height goes to weighted spacers 3 : 5 : 4 : 3 (edge, header-BG, BG-bottom, edge),
             so the rows sit close together but calm at 5x2 cells (406x206 dp) and shrink with a smaller widget -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- Header: profile (always), target (temp target: blue icon + remaining time), current ISF (+ AutoISF factor),
             basal at the right end only when it deviates from the profile (chip) or an SMB just ran. Display only. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxWidth="110dp"
                android:textSize="12.5sp"
                tools:text="Lyumjev FCL" />

            <ImageView
                android:id="@+id/target_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_target" />

            <TextView
                android:id="@+id/target"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                tools:text="5,0" />

            <TextView
                android:id="@+id/isf"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="12.5sp"
                tools:text="ISF 4,1" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- basal: chip (background set in code) or quiet text; GONE when the basal equals the profile -->
            <LinearLayout
                android:id="@+id/basal"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="9dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/basal_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/basal_text"
                    style="@style/WidgetGlassText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    tools:text="0 U/h seit 25′" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- BG block. Fresh: BG + (arrow over age), centred. Stale / no data (Widget.kt): top gravity, smaller BG or "– –",
                 arrow column gone, the age / "Keine Daten seit 01:18" line under it (bg_status) on the Ø Glukose baseline -->
            <LinearLayout
                android:id="@+id/bg_block"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bg"
                    style="@style/WidgetGlassText.Bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-1.5dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_glass_in"
                    android:textSize="44sp"
                    tools:text="6,5" />

                <LinearLayout
                    android:id="@+id/age_column"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/arrow"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/age"
                        style="@style/WidgetGlassText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:textSize="12sp"
                        tools:text="vor 1′" />
                </LinearLayout>
            </LinearLayout>

                <!-- stale: "vor 23 Min. · zuletzt tief"; no data: "Keine Daten seit 01:18" (+ second line "zuletzt 3,8 tief") -->
                <TextView
                    android:id="@+id/bg_status"
                    style="@style/WidgetGlassText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="1.7dp"
                    android:maxLines="2"
                    android:textColor="@color/widget_glass_high"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="vor 23 Min." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_block"
                android:layout_width="142dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir1_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_24h"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir1_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir1"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir2_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_7d"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir2_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir2"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tir3_label"
                    style="@style/WidgetGlassText"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_tir_30d"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_track" />

                    <ImageView
                        android:id="@+id/tir3_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_meter_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <ImageView
                            android:layout_width="1.2dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_meter_tick" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="10" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tir3"
                    style="@style/WidgetGlassText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/widget_glass_txt1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 14 day mean glucose and HbA1c (statistics screen numbers), long-term so not range coloured and not dimmed when stale.
                 Both rows or none: Widget.kt hides the group without data or with less than 7 days. -->
            <LinearLayout
                android:id="@+id/longterm_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/mean_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mean_label"
                        style="@style/WidgetGlassText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/widget_mean_glucose"
                        android:textColor="@color/widget_glass_txt3"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/mean_value"
                        style="@style/WidgetGlassText"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/widget_glass_txt2"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/a1c_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a1c_label"
                        style="@style/WidgetGlassText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/widget_hba1c"
                        android:textColor="@color/widget_glass_txt3"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/a1c_value"
                        style="@style/WidgetGlassText"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/widget_glass_txt2"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_iob"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/iob"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_cob"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cob"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tdd"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tdd"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14.5sp" />
        </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        <!-- Right group: calculator pill, quick-bolus pills or the lock text. While the quick bolus is locked by old / no data
             a caption "BZ manuell" sits over the calculator pill on the IOB / KH / TDD label line (it may run into the lock
             column, whose texts are right-aligned and leave that space free). -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

        <!-- caption column: same metrics as the IOB column (label + invisible 16 sp value) so the baselines match -->
        <LinearLayout
            android:id="@+id/carbs_caption_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/carbs_caption"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/widget_calc_manual"
                android:textColor="@color/widget_glass_txt2"
                android:textSize="11sp" />

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:text=" "
                android:textSize="16sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- Carbs pill: calculator glyph, opens the AAPS bolus wizard (WidgetWizardActivity -> MainActivity), no amount of its own -->
        <FrameLayout
            android:id="@+id/carbs"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/widget_carbs_description">

            <ImageView
                android:id="@+id/carbs_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <ImageView
                android:id="@+id/carbs_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_calculator" />
        </FrameLayout>

        <!-- Locked quick bolus: the two pills are replaced by "Schnellbolus" / "gesperrt · tief" on the IOB / KH / TDD grid; tap explains -->
        <LinearLayout
            android:id="@+id/bolus_locked"
            android:layout_width="136dp"
            android:layout_height="48dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/widget_quick_bolus"
                android:textColor="@color/widget_glass_txt3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bolus_locked_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_glass_txt2"
                android:textSize="12.5sp"
                tools:text="gesperrt · tief" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bolus1"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="0dp">

            <ImageView
                android:id="@+id/bolus1_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <TextView
                android:id="@+id/bolus1_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bolus2"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/bolus2_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill" />

            <TextView
                android:id="@+id/bolus2_text"
                style="@style/WidgetGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_glass_txt1"
                android:textSize="14sp" />
        </FrameLayout>

        </LinearLayout>
        </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />
    </LinearLayout>
</FrameLayout>
