<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Shared with the Halo, Glass and Orbit faces (one setting, see strings_face_bolus.xml). Default OFF.
         Watch-only key, not part of the CustomWatchface preference list, so a CWF zip cannot enable it.
         No summaryOn/summaryOff: they would hide the safety summary. -->
    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_face_bolus_request_enabled"
        android:summary="@string/pref_face_bolus_request_enabled_summary"
        android:title="@string/pref_face_bolus_request_enabled"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <ListPreference
        android:defaultValue="0.5"
        android:dependency="@string/key_face_bolus_request_enabled"
        android:entries="@array/face_bolus_request_amount_names"
        android:entryValues="@array/face_bolus_request_amount_values"
        android:key="@string/key_face_bolus_request_amount"
        android:summary="%s"
        android:title="@string/pref_face_bolus_request_amount" />

    <!-- Shared with Orbit and Halo, watch-only keys (strings_face_bolus.xml, BolusRequestPrefs): "fixed" keeps today's double tap
         that sends the amount above; "picker" makes the same double tap open the quick-bolus picker. The shared switch
         above stays the master switch. -->
    <ListPreference
        android:defaultValue="fixed"
        android:dependency="@string/key_face_bolus_request_enabled"
        android:entries="@array/face_bolus_request_mode_names"
        android:entryValues="@array/face_bolus_request_mode_values"
        android:key="@string/key_face_bolus_request_mode"
        android:summary="%s"
        android:title="@string/pref_face_bolus_request_mode" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:dependency="@string/key_face_bolus_request_enabled"
        android:key="@string/key_face_bolus_request_allow_1_5"
        android:summary="@string/pref_face_bolus_request_allow_1_5_summary"
        android:title="@string/pref_face_bolus_request_allow_1_5"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_date"
        android:summaryOff="@string/off"
        android:summaryOn="@string/on"
        android:title="@string/pref_show_date"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <!-- Always-on style, shared with the Halo, Glass and Orbit faces (strings_face_aod.xml, AodStyle); Glass names its looks (strings_face_aod_glass.xml). -->
    <ListPreference
        android:defaultValue="outline"
        android:entries="@array/face_aod_style_names_glass"
        android:entryValues="@array/face_aod_style_values"
        android:key="@string/key_face_aod_style"
        android:summary="%s"
        android:title="@string/pref_face_aod_style" />

</PreferenceScreen>
