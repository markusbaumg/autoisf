<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Default OFF. Own key, not part of the CustomWatchface preference list, so a CWF zip cannot enable it. -->
    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_orbit_bolus_double_tap"
        android:summary="@string/pref_orbit_bolus_double_tap_summary"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_orbit_bolus_double_tap"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <ListPreference
        android:defaultValue="0.5"
        android:dependency="@string/key_orbit_bolus_double_tap"
        android:entries="@array/kusi_bolus_amount_names"
        android:entryValues="@array/kusi_bolus_amount_values"
        android:key="@string/key_orbit_bolus_amount"
        android:summary="%s"
        android:title="@string/pref_orbit_bolus_amount" />

</PreferenceScreen>
