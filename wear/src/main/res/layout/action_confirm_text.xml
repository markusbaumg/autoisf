<?xml version="1.0" encoding="utf-8"?>
<!-- Page 1 of the watch confirm screen (AcceptActivity): what is confirmed, its warnings, effect and timing.
     Filled by ConfirmScreen. Scrolls with touch and the rotary bezel. The bottom shade keeps scrolled text away from
     the pager's page dots: it fades to black above them and is solid black behind them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/message_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="56dp"
        android:fillViewport="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <!-- 32dp sides: cards and chips stay inside the circle down to the bottom shade; the padding at the bottom
             lets the last line scroll above the shade, and short content is centred in the readable band -->
        <LinearLayout
            android:id="@+id/confirm_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="28dp"
            android:paddingEnd="32dp"
            android:paddingBottom="50dp">

            <TextView
                android:id="@+id/confirm_error_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/confirm_error_ring"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="!"
                android:textColor="@color/confirm_danger"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/confirm_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:maxLines="2"
                android:textColor="@color/confirm_muted"
                android:textSize="16sp"
                tools:text="BOLUS" />

            <TextView
                android:id="@+id/confirm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/confirm_text_dim"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Frühstück gross"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/confirm_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/confirm_text"
                android:textSize="46sp"
                tools:text="0,5 U" />

            <TextView
                android:id="@+id/confirm_amount2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/confirm_text_dim"
                android:textSize="20sp"
                android:visibility="gone"
                tools:text="+ 20 g KH"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/confirm_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/confirm_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/confirm_text"
                android:textSize="17sp"
                android:visibility="gone"
                tools:text="message" />

            <TextView
                android:id="@+id/confirm_swipe_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/confirm_swipe_hint"
                android:textColor="@color/confirm_ok"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/confirm_bottom_shade"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:background="@drawable/confirm_bottom_shade" />

    <!-- more below: shown by ConfirmScreen while the page can scroll further down -->
    <ImageView
        android:id="@+id/confirm_scroll_cue"
        android:layout_width="22dp"
        android:layout_height="10dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/confirm_scroll_cue"
        android:visibility="invisible" />

</FrameLayout>
