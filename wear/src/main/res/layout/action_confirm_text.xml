<?xml version="1.0" encoding="utf-8"?>
<!-- Page 1 of the watch confirm screen (AcceptActivity): what is confirmed, its warnings, effect and timing.
     Filled by ConfirmScreen. Scrolls with touch and the rotary bezel. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/message_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:focusable="true"
    android:fadingEdgeLength="36dp"
    android:focusableInTouchMode="true"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/confirm_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/confirm_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="3"
            android:textColor="@color/confirm_muted"
            android:textSize="14sp"
            tools:text="Bolus" />

        <TextView
            android:id="@+id/confirm_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/confirm_text"
            android:textSize="48sp"
            tools:text="0,5 U" />

        <TextView
            android:id="@+id/confirm_amount2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/confirm_text_dim"
            android:textSize="20sp"
            android:visibility="gone"
            tools:text="+ 20 g KH"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/confirm_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/confirm_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/confirm_text"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="message" />

        <TextView
            android:id="@+id/confirm_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/confirm_swipe_hint"
            android:textColor="@color/confirm_ok"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
