<?xml version="1.0" encoding="utf-8"?>
<!-- Always-on (MonoAod) of the Halo, Glass and Orbit faces: one black-and-white look, no setting. -->
<resources>
    <!-- the data age on its own line under the BG ("8′ ago"), so it cannot pass for a number -->
    <string name="face_aod_age_ago">%1$s ago</string>
    <!-- the watch's own battery at the bottom of the always-on screen -->
    <string name="face_aod_battery">%1$d%%</string>
</resources>
